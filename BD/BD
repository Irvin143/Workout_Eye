-- Tabla: Usuarios
CREATE TABLE Usuarios (
    UsuarioID INT PRIMARY KEY IDENTITY(1,1),
    Nombre VARCHAR(100) NOT NULL,
    contrasena VARCHAR(100) NOT NULL,
    Genero CHAR(1) CHECK (Genero IN ('M', 'F', 'O')),
    Edad INT CHECK (Edad >= 0),
    FechaRegistro DATETIME DEFAULT GETDATE()
);
GO

-- Tabla: Ejercicios
CREATE TABLE Ejercicios (
    EjercicioID INT PRIMARY KEY IDENTITY(1,1),
    Nombre VARCHAR(100) NOT NULL,
    GrupoMuscular VARCHAR(50)
);
GO

-- Tabla: EstadisticasEjercicio
CREATE TABLE EstadisticasEjercicio (
    EstadisticaID INT PRIMARY KEY IDENTITY(1,1),
    UsuarioID INT NOT NULL,
    EjercicioID INT NOT NULL,
    Repeticiones INT CHECK (Repeticiones >= 0),
    ErroresPostura INT CHECK (ErroresPostura >= 0),
    PuntajeTecnica DECIMAL(5,2) CHECK (PuntajeTecnica BETWEEN 0 AND 10),
    FOREIGN KEY (UsuarioID) REFERENCES Usuarios(UsuarioID),
    FOREIGN KEY (EjercicioID) REFERENCES Ejercicios(EjercicioID)
);
GO
-- Procedimiento para insertar o actualizar EstadisticasEjercicio
CREATE OR ALTER PROC sp_actualizar_estadisticas_ejercicio
    @UsuarioID INT,
    @nombre varchar(100),
    @Repeticiones INT,
    @ErroresPostura INT,
    @PuntajeTecnica DECIMAL(5,2)
AS
BEGIN

    DECLARE @EjercicioID INT;
    select @EjercicioID = EjercicioID from Ejercicios where Nombre = @nombre;
	if @EjercicioID IS NULL
    BEGIN
        RAISERROR('El ejercicio no existe', 16, 1);
    END
    IF EXISTS (
        SELECT 1 FROM EstadisticasEjercicio
        WHERE UsuarioID = @UsuarioID AND EjercicioID = @EjercicioID
    )
    BEGIN
        UPDATE EstadisticasEjercicio
        SET Repeticiones = Repeticiones + @Repeticiones,
            ErroresPostura = ErroresPostura + @ErroresPostura,
            PuntajeTecnica = (PuntajeTecnica + @PuntajeTecnica) / 2
        WHERE UsuarioID = @UsuarioID AND EjercicioID = @EjercicioID;

        IF @@ERROR <> 0
        BEGIN
            RAISERROR('Error al actualizar EstadisticasEjercicio', 16, 10);
        END
    END
    ELSE
    BEGIN
        INSERT INTO EstadisticasEjercicio (UsuarioID, EjercicioID, Repeticiones, ErroresPostura, PuntajeTecnica)
        VALUES (@UsuarioID, @EjercicioID, @Repeticiones, @ErroresPostura, @PuntajeTecnica);

        IF @@ERROR <> 0
        BEGIN
            RAISERROR('Error al insertar en EstadisticasEjercicio', 16, 10);
        END
    END
END
