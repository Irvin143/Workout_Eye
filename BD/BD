-- Procedimiento para insertar o actualizar Usuarios
CREATE OR ALTER PROC sp_grabar_usuario
    @UsuarioID INT OUTPUT,
    @Nombre VARCHAR(100),
    @contrasena VARCHAR(100),
    @Genero CHAR(1),
    @Edad INT
AS
BEGIN
    SET NOCOUNT ON;
    IF @UsuarioID IS NULL  or @UsuarioID = 0
    BEGIN
        -- Verificar si ya existe un usuario con el mismo nombre
        IF EXISTS (SELECT 1 FROM Usuarios WHERE Nombre = @Nombre)
        BEGIN
            RAISERROR('Ya existe un usuario con ese nombre', 16, 1);
        END

        INSERT INTO Usuarios (Nombre, contrasena, Genero, Edad)
        VALUES (@Nombre, @contrasena, @Genero, @Edad);

        IF @@ERROR <> 0
        BEGIN
            RAISERROR('Error al insertar en la tabla Usuarios', 16, 10);
        END

        set @UsuarioID = SCOPE_IDENTITY()
    END
END
