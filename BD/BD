-- Crear la base de datos (opcional)
CREATE DATABASE WorkoutEyeDB;
GO

-- Usar la base de datos
USE WorkoutEyeDB;
GO

-- Tabla: Usuarios
CREATE TABLE Usuarios (
    UsuarioID INT PRIMARY KEY IDENTITY(1,1),
    Nombre VARCHAR(100) NOT NULL,
    contrasena VARCHAR(100) NOT NULL,
    Genero CHAR(1) CHECK (Genero IN ('M', 'F', 'O')),
    Edad INT CHECK (Edad >= 0),
    FechaRegistro DATETIME DEFAULT GETDATE()
);
GO

-- Tabla: Ejercicios
CREATE TABLE Ejercicios (
    EjercicioID INT PRIMARY KEY IDENTITY(1,1),
    Nombre VARCHAR(100) NOT NULL,
    GrupoMuscular VARCHAR(50)
);
GO

-- Tabla: EstadisticasEjercicio
CREATE TABLE EstadisticasEjercicio (
    EstadisticaID INT PRIMARY KEY IDENTITY(1,1),
    UsuarioID INT NOT NULL,
    EjercicioID INT NOT NULL,
    Repeticiones INT CHECK (Repeticiones >= 0),
    ErroresPostura INT CHECK (ErroresPostura >= 0),
    PuntajeTecnica DECIMAL(5,2) CHECK (PuntajeTecnica BETWEEN 0 AND 10),
    FOREIGN KEY (UsuarioID) REFERENCES Usuarios(UsuarioID),
    FOREIGN KEY (EjercicioID) REFERENCES Ejercicios(EjercicioID)
);
GO

-- Procedimiento para insertar o actualizar Usuarios
CREATE OR ALTER PROC sp_grabar_usuario
    @UsuarioID INT OUTPUT,
    @Nombre VARCHAR(100),
    @contrasena VARCHAR(100),
    @Genero CHAR(1),
    @Edad INT
AS
BEGIN
    IF EXISTS (SELECT 1 FROM Usuarios WHERE UsuarioID = @UsuarioID)
    BEGIN
        UPDATE Usuarios
        SET Nombre = @Nombre,
            contrasena = @contrasena,
            Genero = @Genero,
            Edad = @Edad
        WHERE UsuarioID = @UsuarioID;

        IF @@ERROR <> 0
        BEGIN
            RAISERROR('Error al actualizar en la tabla Usuarios', 16, 10);
        END
    END
    ELSE
    BEGIN
        INSERT INTO Usuarios (Nombre, contrasena, Genero, Edad)
        VALUES (@Nombre, @contrasena, @Genero, @Edad);

        IF @@ERROR <> 0
        BEGIN
            RAISERROR('Error al insertar en la tabla Usuarios', 16, 10);
        END

        SELECT @UsuarioID = SCOPE_IDENTITY()
    END
END
GO
